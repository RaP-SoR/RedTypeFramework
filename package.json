{
  "name": "cfxtypeframework",
  "version": "0.0.1",
  "description": "CFXTypeFramework(CTF) is a framework for creating Cfx resources with TypeScript and Vue 3",
  "author": "RaPSoR",
  "private": true,
  "workspaces": [
    "core",
    "modules/*",
    "resources/*",
    "tools/*",
    "cfx-ui"
  ],
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "node build.js && yarn workspace cfx-ui build",
    "dev": "concurrently \"yarn watch\" \"yarn workspace cfx-ui dev\"",
    "watch": "node build.js",
    "build:core": "node build.js",
    "build:ui": "yarn workspace cfx-ui build",
    "preview": "yarn workspace cfx-ui preview",
    "type-check": "vue-tsc --noEmit && yarn workspace cfx-ui type-check"
  },
  "dependencies": {
    "@citizenfx/client": "^2.0.14862-1",
    "@citizenfx/server": "^2.0.14862-1",
    "ts-node": "^10.9.2",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@types/node": "^24.0.3",
    "@vitejs/plugin-vue": "^4.2.3",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.5",
    "typescript": "^5.0.4",
    "vite": "^4.3.9",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-vuetify": "1.0.2",
    "vue-tsc": "^2.2.10"
  },
  "resolutions": {
    "unplugin": "1.6.0",
    "unplugin-auto-import": "0.16.7",
    "unplugin-vue-components": "0.25.2",
    "unplugin-fonts": "1.0.3"
  },
  "engines": {
    "yarn": ">=1.22.0",
    "npm": "please-use-yarn"
  }
}
